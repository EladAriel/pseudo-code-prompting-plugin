{
  "skill_id": "prompt-structurer",
  "name": "Prompt Structurer",
  "description": "Transform natural language to pseudo-code using PROMPTCONVERTER methodology",
  "agent_name": "pseudo-code-prompting-plugin-v2:requirement-structurer",
  "version": "2.1.2",
  "tier": "internal",
  "tokens_estimate": 105,
  "triggers": {
    "keywords": [
      "transform",
      "structure",
      "pseudo-code",
      "convert query",
      "function syntax",
      "formalize request"
    ],
    "patterns": [
      "convert.*to.*pseudo",
      "structure.*request",
      "transform.*query",
      "formalize.*feature",
      "run transform:"
    ],
    "contexts": [
      "ambiguous user request",
      "verbose feature description",
      "unstructured requirement"
    ]
  },
  "capabilities": [
    "intent-analysis",
    "function-naming",
    "parameter-extraction",
    "constraint-inference",
    "semantic-preservation",
    "context-detection",
    "auto-compression",
    "cc10x-bridge-integration"
  ],
  "use_cases": [
    "Converting natural language feature requests to structured format",
    "Reducing ambiguity in requirements",
    "Creating searchable, parseable directives",
    "Generating production-ready pseudo-code specifications"
  ],
  "when_to_load_tier_2": [
    "User request needs structuring",
    "Starting feature-dev workflow",
    "Ambiguous requirements detected",
    "User runs 'Run transform:' command"
  ]
}
